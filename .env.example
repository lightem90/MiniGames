# Copy to .env and fill in. .env is never committed or copied into the Docker image.
# Without LLM_API_KEY the game still works, using simple local specs instead of the LLM.
LLM_API_KEY=

# Optional. Defaults: Gemini's OpenAI-compatible endpoint and model.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.8-flash

# DeepSeek instead:
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash

# Optional sign-in buttons. Each appears only when its ID is set. These IDs are public (no secret needed).
# Google: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID, type "Web application",
#   Authorized JavaScript origins: http://localhost:8080 (and your real domain later). No redirect URI needed.
# Microsoft: entra.microsoft.com -> App registrations -> New, account type "Any org + personal Microsoft accounts",
#   platform "Single-page application", redirect URI: http://localhost:8080/ (and your real domain later).
GOOGLE_CLIENT_ID=
MS_CLIENT_ID=
